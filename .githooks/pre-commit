#!/bin/sh
# Не дати закомітити секрет.
#
# Репозиторій публічний, тож ключ, який потрапив у коміт і поїхав на GitHub,
# вважається скомпрометованим — навіть якщо наступним комітом його прибрати.
# Історію бачать форки, клони й кеш GitHub. Дешевше не пустити.
#
# Вмикається один раз на машину:  git config core.hooksPath .githooks

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks не встановлений — перевірити коміт на секрети нема чим."
  echo "Постав:  brew install gitleaks"
  echo "Свідомо пропустити:  git commit --no-verify"
  exit 1
fi

# --redact: якщо секрет таки знайдеться, він не має ще й осісти у виводі
# терміналу, звідки його потім скопіюють у чат разом із помилкою.
if ! gitleaks git --staged --redact --no-banner -v; then
  echo
  echo "Схоже на секрет у тому, що ви комітите — дивіться рядки вище."
  echo "Якщо це хибне спрацювання: коментар  gitleaks:allow  у тому ж рядку"
  echo "або запис у .gitleaksignore."
  exit 1
fi
